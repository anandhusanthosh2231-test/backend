# -----------------------------------------------------------------------------
# AI Recipes: Environment Variables Reference
# -----------------------------------------------------------------------------

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_recipes

# Port & Server Configuration
PORT=5000
BASE_PATH=/
SESSION_SECRET=   # Secret string for signing session cookies

# Admin Allow-List Security (Server Only — Never use VITE_ prefix!)
ADMIN_ALLOWLIST_PEPPER=   # Secret string used as HMAC key for email hashing
ADMIN_ALLOWLIST_HASHES=   # Comma-separated list of HMAC-SHA256 hashes generated by scripts/admin-allowlist.mjs

# Admin UI URL (use the same dedicated random path in both variables)
ADMIN_PATH=/replace-with-the-same-random-path
VITE_ADMIN_PATH=/replace-with-the-same-random-path # Included in the public frontend bundle; obfuscation only

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth 2.0 Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public Site Clerk Authentication (Optional)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Optional Cloudflare R2 recipe image storage (server only; never use VITE_ prefix)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_MAX_FILE_SIZE_BYTES=8388608

# Optional ImageKit media library (backend only; never use VITE_ prefix)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_MAX_FILE_SIZE_BYTES=20971520

# Public VYBE discovery requires both flags to be enabled; keep disabled during development.
# The API flag is server-only. The Vite flag controls only public navigation/rendering.
VYBE_ENABLED=false
VITE_VYBE_ENABLED=false
