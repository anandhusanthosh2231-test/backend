# -----------------------------------------------------------------------------
# AI Recipes: Environment Variables Reference
# -----------------------------------------------------------------------------

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_recipes

# Port & Server Configuration
PORT=5000
BASE_PATH=/
SESSION_SECRET=   # Secret string for signing session cookies

# Admin Allow-List Security (Server Only — Never use VITE_ prefix!)
ADMIN_ALLOWLIST_PEPPER=   # Secret string used as HMAC key for email hashing
ADMIN_ALLOWLIST_HASHES=   # Comma-separated list of HMAC-SHA256 hashes generated by scripts/admin-allowlist.mjs

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth 2.0 Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public Site Clerk Authentication (Optional)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
